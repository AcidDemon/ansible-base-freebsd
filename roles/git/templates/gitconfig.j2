# Managed by Ansible
[user]
	name = {{ git_user_name }}
	email = {{ git_user_email }}
[core]
	editor = vim
	pager = less -RFX
[init]
	defaultBranch = main
[pull]
	rebase = false
[push]
	default = simple
	autoSetupRemote = true
[color]
	ui = auto
[alias]
	st = status
	co = checkout
	br = branch
	ci = commit
	lg = log --oneline --graph --decorate
