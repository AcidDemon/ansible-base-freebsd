#!/bin/sh
# Managed by Ansible
#
# Clean jobs print nothing (security_show_success and weekly_show_success are
# NO), so this line tells a clean run from one that never ran. It lands last
# because /usr/local/etc/periodic runs after /etc/periodic.
echo ""
echo "Every enabled periodic job not listed above ran cleanly and had nothing to report."
# 1 = "notable information", so this line is never masked by show_success itself.
exit 1
